<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Counter4F2.Models"
             x:DataType="models:AllCountersModel"
             x:Class="Counter4F2.Views.AllCountersPage"
             Title="Your counters">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add Counter"
                     Clicked="AddCounterBtn_Click"
                     />


    </ContentPage.ToolbarItems>

    <ScrollView>



        <CollectionView ItemsSource="{Binding AllCountersCollection}" 
                        SelectionMode="Single"
                        SelectionChanged="CountersCollectionView_SelectionChanged"
                        x:Name="CountersCollevtionView"
                        >
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Border StrokeShape="RoundRectangle 10" 
                                StrokeThickness="2" 
                                Grid.ColumnSpan="2" 
                                HeightRequest="200" 
                                WidthRequest="350"
                                Margin="0,10"
                                >
                            <Grid x:DataType="models:CounterModel" Margin="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="4*"/>
                                    <RowDefinition Height="2*"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label FontSize="15" 
                                       HorizontalTextAlignment="Center" 
                                       VerticalTextAlignment="Center" 
                                       Text="{Binding Name}" 
                                       Grid.ColumnSpan="2"
                                       Grid.Row="0"
                                       />

                                <Label FontSize="55" 
                                       HorizontalTextAlignment="Center" 
                                       VerticalTextAlignment="Center" 
                                       Text="{Binding Count}" 
                                       TextColor="{Binding Color}"
                                       Grid.ColumnSpan="2"
                                       Grid.Row="1"
                                       />


                                <Button  x:Name="DecraseCountBtn"
                                         Clicked="DecraseCountBtn_Clicked"
                                         Grid.Row="2"
                                         Margin="3"
                                         ImageSource="{FontImage FontFamily='OpenSansRegular', Color='Black', Glyph='-', Size=40}"
                                         />
                                <Button  x:Name="IncraseCountBtn" 
                                         Clicked="IncraseCountBtn_Clicked" 
                                         Grid.Row="2" Grid.Column="1" 
                                         Margin="3"
                                         ImageSource="{FontImage FontFamily='OpenSansRegular', Color='Black', Glyph='+', Size=40}"
                                         />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


    </ScrollView>
</ContentPage>