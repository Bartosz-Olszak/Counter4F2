<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter4F2.Views.CounterPage"
             xmlns:models ="clr-namespace:Counter4F2.Models"
             Title="Counter">
    <Grid x:Name="CounterGrid">
        <Border StrokeShape="RoundRectangle 10" 
        StrokeThickness="2" 
        Grid.ColumnSpan="2" 
        Margin="50, 100"
        >
            <Grid x:DataType="models:CounterModel" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid  HorizontalOptions="Fill"
                       Grid.ColumnSpan="2"
                       VerticalOptions="Start"
                       Margin="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <Button WidthRequest="60"
                            HeightRequest="60"
                            BackgroundColor="Transparent"
                            Clicked="BackBtn_Clicked"
                            
                            ImageSource="{FontImage FontFamily='OpenSansRegular', Color='White', Glyph='&lt;', Size=40}"/>

                    <Editor FontSize="15" 
                           HorizontalTextAlignment="Center" 
                           VerticalTextAlignment="Center" 
                           Text="{Binding Name}" 
                           Margin="0, 10, 0, 10"
                           HeightRequest="60"
                           Grid.Row="0"
                           HorizontalOptions="Fill"
                           Grid.Column="1"
                           
                           />

                    <Button WidthRequest="100"
                            HeightRequest="60"
                            Grid.Column="2"
                            Clicked="ResetBtn_Clicked"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            Text="Reset"/>


                    <Button WidthRequest="60"
                            HeightRequest="60"
                            Grid.Column="3"
                            Clicked="DeleteBtn_Clicked"
                            BackgroundColor="Transparent"
                            ImageSource="{FontImage FontFamily='OpenSansRegular', Color='White', Glyph='x', Size=40}"/>
                </Grid>

                <Grid Grid.ColumnSpan="2"
                      Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="4*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <VerticalStackLayout>
                        <VerticalStackLayout Margin="20, 5">

                            <Label Text="Red"
                                   Margin="0, 5"/>

                            <Editor x:Name="RedEditor"
                                    Text="{Binding R}"
                                    HorizontalOptions="Start"
                                    WidthRequest="100"
                                    Keyboard="Numeric"
                                    Placeholder="123"
                                    TextChanged="RedEditor_TextChanged"/>

                        </VerticalStackLayout>


                        <VerticalStackLayout Margin="20, 5">

                            <Label Text="Green"
                                   Margin="0, 5"/>

                            <Editor x:Name="GreenEditor"
                                    WidthRequest="100"
                                    HorizontalOptions="Start"
                                    Text="{Binding G}"
                                    Keyboard="Numeric"
                                    Placeholder="123"
                                    TextChanged="GreenEditor_TextChanged"/>

                        </VerticalStackLayout>

                        <VerticalStackLayout Margin="20, 5">

                            <Label Text="Blue"
                                   Margin="0, 5"/>

                            <Editor x:Name="BlueEditor"
                                    Text="{Binding B}"
                                    HorizontalOptions="Start"
                                    WidthRequest="100"
                                    Keyboard="Numeric"
                                    Placeholder="123"
                                    TextChanged="BlueEditor_TextChanged"/>

                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Label FontSize="55" 
                       HorizontalTextAlignment="Center" 
                       VerticalTextAlignment="Center" 
                       TextColor="{Binding Color}"
                       Text="{Binding Count}" 
                       Grid.Column="1"
                       />

                </Grid>




                <Button  x:Name="DecraseCountBtn"
                         Clicked="DecraseCountBtn_Clicked"
                         Grid.Row="2"
                         ImageSource="{FontImage FontFamily='OpenSansRegular', Color='Black', Glyph='-', Size=40}"
                         Margin="10"
                         />
                <Button  x:Name="IncraseCountBtn" 
                         Clicked="IncraseCountBtn_Clicked" 
                         Grid.Row="2" Grid.Column="1" 
                         Margin="10"
                         ImageSource="{FontImage FontFamily='OpenSansRegular', Color='Black', Glyph='+', Size=40}"
                         />
            </Grid>
        </Border>
    </Grid>
</ContentPage>